# Copy this to .env and fill in your values
# cp .env.example .env

# --- Database ---
DB_PATH=tech_intel.db

# --- Ollama ---
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# --- Reddit (free developer app — create at reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tech-intel/1.0 by your_reddit_username

# --- Telegram (create bot via @BotFather, get chat ID via @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Briefing ---
# Options: beginner | professional
BRIEFING_STYLE=beginner
BRIEFING_HOUR=8

# --- Ingestion ---
INGESTION_INTERVAL_MINUTES=30
